{
  "version": 2,
  "functions": { "api/index.js": { "maxDuration": 60, "includeFiles": "{providers,public,assets}/**" } },
  "rewrites": [
    { "source": "/addon/:path*", "destination": "/api/nuvio?route=:path*" },
    { "source": "/manifest.json", "destination": "/api/index" },
    { "source": "/catalog/:path*", "destination": "/api/index" },
    { "source": "/meta/:path*", "destination": "/api/index" }
  ]
}
